<!-- L'application ne prend pas le thème Fluent de Windows 11 (ThemeMode). Ce thème, encore expérimental dans
     .NET 10, fait lisser toutes les lettres en gris au lieu de ClearType, d'où un texte qui paraît « basse fidélité »,
     mesuré le 23/11/2026 (aucun pixel ClearType avec le thème, plus d'un millier sans lui). La fenêtre dessine déjà
     elle-même presque tous ses éléments. Les trois que le thème habillait encore sont ici, en sombre : les barres
     de défilement, les bulles d'aide et le menu du clic droit dans un champ. -->
<Application x:Class="YtDlpInterface.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="FenetrePrincipale.xaml">
    <Application.Resources>
        <!-- Les mêmes teintes que la palette de la fenêtre, qui n'est pas encore lue quand ces styles le sont. -->
        <SolidColorBrush x:Key="AppFond" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="AppFilet" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="AppTexte" Color="#EDEDED"/>
        <SolidColorBrush x:Key="AppTexteInactif" Color="#5C5C5C"/>
        <SolidColorBrush x:Key="AppPouce" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="AppPouceSurvol" Color="#525252"/>

        <!-- Barre de défilement : un pouce fin et discret, sans flèches. Il s'épaissit d'un rien sous la souris. -->
        <Style x:Key="AppPouceDeDefilement" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pouce" Background="{StaticResource AppPouce}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pouce" Property="Background" Value="{StaticResource AppPouceSurvol}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pouce" Property="Background" Value="{StaticResource AppPouceSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppPisteDeDefilement" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AppPisteDeDefilement}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AppPisteDeDefilement}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AppPouceDeDefilement}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppPisteDeDefilement}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppPisteDeDefilement}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AppPouceDeDefilement}"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bulle d'aide : le fond des champs, un filet, le texte clair, coupée en lignes au-delà d'une largeur lisible. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource AppTexte}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource AppFond}" BorderBrush="{StaticResource AppFilet}" BorderThickness="1"
                                CornerRadius="2" Padding="10,6" MaxWidth="440">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu du clic droit dans un champ (couper, copier, coller). -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource AppTexte}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource AppFond}" BorderBrush="{StaticResource AppFilet}" BorderThickness="1"
                                CornerRadius="2" Padding="0,4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource AppTexte}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Rangee" Background="Transparent" Padding="14,6" MinWidth="180">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           VerticalAlignment="Center" Foreground="#8A8A8A"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Rangee" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource AppTexteInactif}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="0,4" Background="{StaticResource AppFilet}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
