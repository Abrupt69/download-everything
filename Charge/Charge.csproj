<Project Sdk="Microsoft.NET.Sdk">

  <!-- Assemblage sans code. Il ne fait que transporter, en ressources, les programmes du dossier fichiers
       (yt-dlp, ffmpeg, ffprobe, Deno), que preparer-charge.ps1 va chercher sur leurs dépôts officiels.
       L'interface ne le charge qu'à la première ouverture, pour les déposer dans le profil de l'utilisateur. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>YtDlpInterface.Charge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chaque ressource porte le nom du fichier, qui sera aussi son nom une fois déposé. -->
    <EmbeddedResource Include="fichiers\*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
