<!-- Fenêtre unique de Download Everything.
     Direction « Panneau avant » : la fenêtre se dessine comme la face avant d'un appareil de mesure.
     Une colonne d'étiquettes en capitales à gauche, les commandes alignées à droite, des filets d'un pixel
     à la place des cadres. Graphite neutre, angles à 2 px, aucun pictogramme, une seule couleur signal (l'ambre)
     réservée à l'action, au focus clavier et à la progression. Les chiffres sont en Bahnschrift, à chasse fixe.
     Grille : marge de 24, colonne d'étiquettes de 112, gouttière de 16, lignes de 52, commandes de 36 de haut. -->
<Window x:Class="YtDlpInterface.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Everything"
        Width="860" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- La progression se voit aussi sur l'icône de la barre des tâches, fenêtre réduite. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="BarreDesTaches"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Palette graphite, sans dominante. Chaque couleur a un seul rôle. -->
        <SolidColorBrush x:Key="Fond" Color="#141414"/>
        <SolidColorBrush x:Key="Champ" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="Survol" Color="#222222"/>
        <SolidColorBrush x:Key="FondJournal" Color="#0F0F0F"/>
        <SolidColorBrush x:Key="Filet" Color="#2E2E2E"/>
        <!-- Contour des champs, à 3,8 pour 1 sur leur fond pour rester visible sans focus. -->
        <SolidColorBrush x:Key="Contour" Color="#767676"/>
        <SolidColorBrush x:Key="Texte" Color="#EDEDED"/>
        <SolidColorBrush x:Key="TexteDoux" Color="#A3A3A3"/>
        <SolidColorBrush x:Key="TexteEtiquette" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TexteInactif" Color="#5C5C5C"/>
        <!-- Le signal. Bouton principal, focus clavier, barre de progression, et rien d'autre. -->
        <SolidColorBrush x:Key="Signal" Color="#FFB000"/>
        <SolidColorBrush x:Key="Reussite" Color="#5FD38D"/>
        <SolidColorBrush x:Key="Alerte" Color="#FF6B5E"/>
        <CornerRadius x:Key="Rayon">2</CornerRadius>

        <!-- Contour ambre autour de l'élément qui a le clavier, décalé vers l'extérieur pour ne pas le toucher. -->
        <Style x:Key="ContourFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-4" RadiusX="3" RadiusY="3" Stroke="{StaticResource Signal}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Étiquette de ligne, comme une sérigraphie de façade. -->
        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontStretch" Value="SemiCondensed"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TexteEtiquette}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Valeur d'une mesure, en chiffres à chasse fixe pour qu'ils ne dansent pas quand ils changent. -->
        <Style x:Key="Mesure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Margin" Value="0,4,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Text" Value="—"/>
        </Style>

        <!-- Ligne du panneau, fermée par un filet sur toute la largeur. -->
        <Style x:Key="Ligne" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Filet}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>

        <!-- Bouton principal, le seul élément plein en couleur signal. -->
        <Style x:Key="BoutonSignal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Signal}"/>
            <Setter Property="Foreground" Value="{StaticResource Fond}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="176"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ContourFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Rayon}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="#FFC233"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="#E09A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Filet}"/>
                                <Setter Property="Foreground" Value="#6B6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire, du texte seul. Un fond léger n'apparaît qu'au survol. -->
        <Style x:Key="BoutonTexte" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ContourFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Rayon}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Survol}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Filet}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TexteInactif}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Touche à deux positions, Vidéo ou Audio. L'active est pleine et claire, l'autre n'a que son contour. -->
        <Style x:Key="Touche" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TexteDoux}"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ContourFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cadre" Background="Transparent" BorderBrush="{StaticResource Contour}" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Survol}"/>
                                <Setter Property="Foreground" Value="{StaticResource Texte}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Texte}"/>
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Texte}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fond}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ de saisie sans cadre, posé dans un cadre qui porte lui-même l'état de focus. -->
        <Style x:Key="ChampNu" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Texte}"/>
            <!-- Sélection en voile clair, le texte reste lisible dessous. -->
            <Setter Property="SelectionBrush" Value="{StaticResource Texte}"/>
            <Setter Property="SelectionOpacity" Value="0.25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ de saisie ordinaire, avec son propre cadre. Le contour passe à l'ambre quand le clavier est dedans. -->
        <ControlTemplate x:Key="GabaritDeChamp" TargetType="Control">
            <Border x:Name="Cadre" Background="{StaticResource Champ}" BorderBrush="{StaticResource Contour}" BorderThickness="1"
                    CornerRadius="{StaticResource Rayon}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Signal}"/>
                    <Setter TargetName="Cadre" Property="BorderThickness" Value="2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ChampEncadre" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Texte}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Texte}"/>
            <Setter Property="SelectionOpacity" Value="0.25"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource GabaritDeChamp}"/>
        </Style>
        <!-- Liste déroulante, dessinée comme un champ avec un chevron tracé. -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ContourFocus}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Style="{x:Null}" écarte le style par défaut du thème, qui rétrécirait ce bouton à la taille de son chevron. -->
                            <ToggleButton Style="{x:Null}" Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Cadre" Background="{StaticResource Champ}" BorderBrush="{StaticResource Contour}"
                                                BorderThickness="1" CornerRadius="{StaticResource Rayon}">
                                            <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TexteDoux}" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Survol}"/>
                                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource TexteDoux}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Filet}"/>
                                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TexteInactif}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="{StaticResource Rayon}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TexteInactif}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Cadre" Background="Transparent" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Case à cocher carrée, à la coche tracée. -->
        <Style x:Key="Case" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ContourFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Boite" Width="16" Height="16" BorderThickness="1" BorderBrush="{StaticResource Contour}"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Path x:Name="Coche" Data="M3,7.5 L6.2,10.5 L12,4" Stroke="{StaticResource Fond}" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource TexteDoux}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Boite" Property="Background" Value="{StaticResource Texte}"/>
                                <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource Texte}"/>
                                <Setter TargetName="Coche" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barre de progression épaisse, aux bouts carrés. Sa couleur est celle de Foreground.
             Tant que le pourcentage est inconnu, un segment la parcourt. La fenêtre a une largeur fixe,
             la course du segment peut donc être écrite en dur (largeur de la colonne des commandes). -->
        <Style x:Key="Avancement" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Signal}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{StaticResource Filet}"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                            <Border x:Name="Segment" Width="96" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-96"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Segment" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Glissement">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Segment"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-96" To="700" Duration="0:0:1.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Glissement"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Journal de yt-dlp. Un fond plus sombre entre deux filets, sans cadre. -->
        <Style x:Key="Console" TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{StaticResource TexteDoux}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Texte}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Texte}"/>
            <Setter Property="SelectionOpacity" Value="0.25"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border x:Name="Cadre" Background="{StaticResource FondJournal}" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,12,2,12" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Signal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Si l'écran est trop petit pour tout montrer (forte échelle d'affichage), le contenu défile au lieu d'être rogné. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,8,24,12">

            <!-- Plaque de l'appareil -->
            <Border Style="{StaticResource Ligne}" MinHeight="44">
                <TextBlock Text="DOWNLOAD EVERYTHING" FontFamily="Bahnschrift" FontStretch="SemiCondensed" FontWeight="SemiBold"
                           FontSize="15" VerticalAlignment="Center"/>
            </Border>

            <!-- Bandeau d'alerte, montré seulement quand un outil manque ou ne répond pas. -->
            <Border x:Name="Bandeau" Visibility="Collapsed" Padding="0,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Alerte}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="ALERTE" Foreground="{StaticResource Alerte}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TexteBandeau" Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive"/>
                    <Button x:Name="BoutonDossierOutils" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Top"
                            Style="{StaticResource BoutonTexte}" Content="Ouvrir ce dossier" Click="OuvrirLeDossierDesOutils"/>
                </Grid>
            </Border>

            <!-- SOURCE -->
            <Border Style="{StaticResource Ligne}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="SOURCE"/>
                    <Grid Grid.Column="2" Height="36">
                        <Border Background="{StaticResource Champ}" BorderBrush="{StaticResource Contour}" BorderThickness="1"
                                CornerRadius="{StaticResource Rayon}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChampAdresse" Style="{StaticResource ChampNu}" Margin="12,0,8,0"
                                     AutomationProperties.Name="Adresse de la vidéo"/>
                            <!-- Texte d'exemple, visible tant que le champ est vide -->
                            <TextBlock Text="Une ou plusieurs adresses à coller ici (vidéo, playlist, lien Spotify)" IsHitTestVisible="False" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TexteEtiquette}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ChampAdresse}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Rectangle Grid.Column="1" Width="1" Margin="0,1" Fill="{StaticResource Filet}"/>
                            <Button x:Name="BoutonColler" Grid.Column="2" Style="{StaticResource BoutonTexte}" Height="34" Margin="0,0,1,0"
                                    Padding="16,0" Content="_Coller" Click="CollerLAdresse" AutomationProperties.Name="Coller l'adresse"/>
                        </Grid>
                        <!-- Contour de focus du champ, posé par-dessus pour ne pas déplacer le contenu. -->
                        <Border BorderBrush="{StaticResource Signal}" BorderThickness="2" CornerRadius="{StaticResource Rayon}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ChampAdresse}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- SORTIE. Les deux touches font ensemble la largeur du bouton Télécharger, qui tombe juste dessous. -->
            <Border Style="{StaticResource Ligne}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="SORTIE"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <RadioButton x:Name="ChoixVideo" Style="{StaticResource Touche}" GroupName="Contenu" Content="Vidéo" IsChecked="True"
                                     Checked="ChangerDeContenu" AutomationProperties.Name="Contenu, vidéo">
                            <RadioButton.Tag>
                                <CornerRadius>2,0,0,2</CornerRadius>
                            </RadioButton.Tag>
                        </RadioButton>
                        <!-- Marge négative d'un pixel pour que les deux contours se recouvrent au lieu de doubler. -->
                        <RadioButton x:Name="ChoixAudio" Style="{StaticResource Touche}" GroupName="Contenu" Content="Audio seul" Margin="-1,0,0,0" Width="89"
                                     Checked="ChangerDeContenu" AutomationProperties.Name="Contenu, audio seul">
                            <RadioButton.Tag>
                                <CornerRadius>0,2,2,0</CornerRadius>
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                    <ComboBox x:Name="ChoixFormat" Grid.Column="4" AutomationProperties.Name="Format"/>
                    <ComboBox x:Name="ChoixQualite" Grid.Column="6" AutomationProperties.Name="Qualité de l'image"/>
                </Grid>
            </Border>

            <!-- DOSSIER. Le nom du dossier d'abord, le chemin qui y mène ensuite, en plus discret. -->
            <Border x:Name="LigneDossier" Style="{StaticResource Ligne}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="DOSSIER"/>
                    <TextBlock x:Name="NomDossier" Grid.Column="2" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CheminParent" Grid.Column="3" Margin="12,1,12,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TexteEtiquette}" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BoutonParcourir" Grid.Column="4" Style="{StaticResource BoutonTexte}"
                            Content="C_hanger" Click="ChoisirLeDossier" AutomationProperties.Name="Changer le dossier de destination"/>
                    <Button x:Name="BoutonOuvrir" Grid.Column="5" Style="{StaticResource BoutonTexte}" Margin="0,0,-12,0"
                            Content="_Ouvrir" Click="OuvrirLeDossierDeDestination" AutomationProperties.Name="Ouvrir le dossier de destination"
                            ToolTip="Ouvrir ce dossier dans l'Explorateur"/>
                </Grid>
            </Border>

            <!-- OPTIONS -->
            <Border Style="{StaticResource Ligne}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="OPTIONS"/>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChoixPlaylist" Style="{StaticResource Case}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Content="Toute la playlist"
                                  ToolTip="Quand l'adresse désigne une vidéo qui fait partie d'une playlist, prendre toute la playlist"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Etiquette}" Text="À LA FOIS"/>
                        <ComboBox x:Name="ChoixSimultanes" Grid.Column="3" AutomationProperties.Name="Nombre de téléchargements à la fois"
                                  ToolTip="Pour les albums, les playlists et plusieurs liens. Au-delà de 5, YouTube refuse plus souvent des demandes."/>
                    </Grid>
                </Grid>
            </Border>

            <!-- SON. Deux réglages qui ne valent que pour le son seul : son débit, et un égaliseur. -->
            <Border Style="{StaticResource Ligne}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="SON"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Etiquette}" Text="QUALITÉ"/>
                    <ComboBox x:Name="ChoixQualiteSon" Grid.Column="4" AutomationProperties.Name="Qualité du son"
                              ToolTip="Débit du son converti (MP3, M4A, Opus). La source dépasse rarement 160 kb/s, un débit plus haut grossit le fichier sans l'améliorer."/>
                    <TextBlock Grid.Column="6" Style="{StaticResource Etiquette}" Text="ÉGALISEUR"/>
                    <ComboBox x:Name="ChoixEgaliseur" Grid.Column="8" AutomationProperties.Name="Égaliseur"
                              ToolTip="Appliqué à chaque son téléchargé en mode Audio seul. Le son est alors réencodé, et le format d'origine devient de l'Opus."/>
                </Grid>
            </Border>

            <!-- Actions, alignées sur la colonne des commandes. Annuler n'apparaît que pendant un travail. -->
            <Grid Margin="0,24,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BoutonTelecharger" Grid.Column="1" Style="{StaticResource BoutonSignal}" Content="_Télécharger"
                        IsDefault="True" Click="Telecharger" AutomationProperties.Name="Télécharger"/>
                <Button x:Name="BoutonAnnuler" Grid.Column="2" Style="{StaticResource BoutonTexte}" Height="40" Padding="16,0" Margin="8,0,0,0"
                        Content="_Annuler" IsCancel="True" Visibility="Collapsed" Click="Annuler"/>
                <Button x:Name="BoutonMettreAJour" Grid.Column="4" Style="{StaticResource BoutonTexte}" Height="40" Margin="0,0,-12,0"
                        Foreground="{StaticResource TexteDoux}" Content="Tout _mettre à jour" Click="MettreAJour"
                        AutomationProperties.Name="Tout mettre à jour"
                        ToolTip="Cherche les dernières versions de yt-dlp, ffmpeg, Deno et spotDL sur leurs dépôts officiels"/>
            </Grid>

            <!-- ÉTAT. Rien au repos. La colonne de gauche sert d'afficheur : le pourcentage en grand, puis le mot de la fin. -->
            <Border x:Name="ZoneEtat" Visibility="Collapsed" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" MinHeight="64" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EtiquetteEtat" Style="{StaticResource Etiquette}" Text="ÉTAT"/>
                    <TextBlock x:Name="Afficheur" FontFamily="Bahnschrift" FontSize="28" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ProgressBar x:Name="BarreProgression" Style="{StaticResource Avancement}" Visibility="Collapsed"
                                     Minimum="0" Maximum="100" AutomationProperties.Name="Progression"/>

                        <!-- Mesures du transfert, une étiquette au-dessus de chaque valeur, comme les cadrans d'un appareil. -->
                        <Grid x:Name="Mesures" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Etiquette}" Text="DÉBIT"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Etiquette}" Text="REÇU"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Etiquette}" Text="RESTE"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Etiquette}" Text="ÉCOULÉ"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource Etiquette}" Text="LIAISON"/>
                            <TextBlock Grid.Column="5" Style="{StaticResource Etiquette}" Text="FORMAT"/>
                            <TextBlock x:Name="MesureDebit" Grid.Row="1" Grid.Column="0" Style="{StaticResource Mesure}"/>
                            <TextBlock x:Name="MesureRecu" Grid.Row="1" Grid.Column="1" Style="{StaticResource Mesure}"/>
                            <TextBlock x:Name="MesureReste" Grid.Row="1" Grid.Column="2" Style="{StaticResource Mesure}"/>
                            <TextBlock x:Name="MesureEcoule" Grid.Row="1" Grid.Column="3" Style="{StaticResource Mesure}"/>
                            <TextBlock x:Name="MesureLiaison" Grid.Row="1" Grid.Column="4" Style="{StaticResource Mesure}"/>
                            <TextBlock x:Name="MesureFormat" Grid.Row="1" Grid.Column="5" Style="{StaticResource Mesure}"/>
                        </Grid>

                        <TextBlock x:Name="TexteEtat" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource TexteDoux}" AutomationProperties.LiveSetting="Polite"/>

                        <!-- Playlist. La barre du haut donne l'ensemble, cette liste dépliable donne chaque vidéo. -->
                        <ToggleButton x:Name="BasculeElements" Style="{StaticResource BoutonTexte}" Height="32" Margin="-12,8,0,0"
                                      HorizontalAlignment="Left" Foreground="{StaticResource TexteDoux}" Visibility="Collapsed"
                                      Content="Afficher le _détail" Checked="BasculerLesElements" Unchecked="BasculerLesElements"/>
                        <Border x:Name="CadreElements" Visibility="Collapsed" Margin="0,4,0,0" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0">
                            <ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl x:Name="Elements" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Filet}" BorderThickness="0,0,0,1" Height="32">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="92"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Numero}" FontFamily="Bahnschrift" Typography.NumeralAlignment="Tabular"
                                                               Foreground="{StaticResource TexteEtiquette}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Titre}" Margin="0,0,16,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Pourcent}"
                                                                 VerticalAlignment="Center">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Avancement}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="terminé">
                                                                        <Setter Property="Foreground" Value="{StaticResource Reussite}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="déjà là">
                                                                        <Setter Property="Foreground" Value="{StaticResource Reussite}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="erreur">
                                                                        <Setter Property="Foreground" Value="{StaticResource Alerte}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="refusé">
                                                                        <Setter Property="Foreground" Value="{StaticResource Alerte}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="introuvable">
                                                                        <Setter Property="Foreground" Value="{StaticResource Alerte}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <TextBlock Grid.Column="3" Text="{Binding Etat}" Margin="16,0,0,0" FontFamily="Bahnschrift" FontSize="12.5"
                                                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TexteDoux}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FICHIER. Le nom du fichier obtenu et de quoi le retrouver. -->
            <Border x:Name="Resultat" Visibility="Collapsed" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" MinHeight="52">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="FICHIER"/>
                    <TextBlock x:Name="NomFichier" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BoutonOuvrirFichier" Grid.Column="3" Style="{StaticResource BoutonTexte}" Margin="12,0,0,0"
                            Content="Ouvrir le _fichier" Click="OuvrirLeFichier"/>
                    <Button x:Name="BoutonMontrerFichier" Grid.Column="4" Style="{StaticResource BoutonTexte}" Margin="0,0,-12,0"
                            Content="Afficher dans le _dossier" Click="MontrerLeFichier"/>
                </Grid>
            </Border>

            <!-- Journal de yt-dlp, replié au repos. Il s'ouvre par le bouton du pied, ou seul en cas d'erreur. -->
            <RichTextBox x:Name="Journal" Style="{StaticResource Console}" Height="180" Visibility="Collapsed"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Journal de yt-dlp">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="LineHeight" Value="18"/>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument PagePadding="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
            </RichTextBox>

            <!-- Compte Spotify, replié au repos. Connecté à son compte, on lit en quelques secondes toutes ses playlists,
                 quelle que soit leur longueur. C'est facultatif, sans connexion tout marche quand même. -->
            <Border x:Name="ZoneCle" Visibility="Collapsed" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" Padding="0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Etiquette}" Text="COMPTE SPOTIFY" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteDoux}" FontSize="13"
                                   Text="Facultatif. Connecté à votre compte, vos playlists se lisent en entier en quelques secondes, même avec plusieurs centaines de titres. Spotify demande un abonnement Premium et ne laisse lire ainsi que vos propres playlists. Le mot de passe se tape sur la page de Spotify, jamais ici."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteDoux}" FontSize="13" Margin="0,10,0,0"
                                   Text="1. Sur le tableau de bord Spotify, créez une application et cochez Web API.  2. Dans Redirect URIs, collez l'adresse de retour ci-dessous.  3. Collez ici le Client ID de l'application, puis connectez-vous."/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EtiquetteIdSpotify" Style="{StaticResource Etiquette}" Text="CLIENT ID" Margin="0,0,0,6"/>
                                <TextBox x:Name="ChampIdSpotify" Style="{StaticResource ChampEncadre}" MaxLength="64"
                                         AutomationProperties.LabeledBy="{Binding ElementName=EtiquetteIdSpotify}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="EtiquetteRetourSpotify" Style="{StaticResource Etiquette}" Text="ADRESSE DE RETOUR" Margin="0,0,0,6"/>
                                <TextBox x:Name="ChampRetourSpotify" Style="{StaticResource ChampEncadre}" IsReadOnly="True"
                                         AutomationProperties.LabeledBy="{Binding ElementName=EtiquetteRetourSpotify}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="-12,8,-12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BoutonConnecterSpotify" Style="{StaticResource BoutonTexte}" Content="Se connecter" Click="ConnecterSpotify"/>
                            <Button x:Name="BoutonDeconnecterSpotify" Grid.Column="1" Style="{StaticResource BoutonTexte}" Foreground="{StaticResource TexteDoux}"
                                    Content="Se déconnecter" Click="DeconnecterSpotify"/>
                            <Button Grid.Column="3" Style="{StaticResource BoutonTexte}" Foreground="{StaticResource TexteDoux}"
                                    Content="Copier l'adresse de retour" Click="CopierLAdresseDeRetour"/>
                            <Button Grid.Column="4" Style="{StaticResource BoutonTexte}" Foreground="{StaticResource TexteDoux}"
                                    Content="Ouvrir le tableau de bord" Click="OuvrirLeTableauDeBordSpotify"
                                    ToolTip="Ouvre developer.spotify.com/dashboard dans le navigateur"/>
                        </Grid>
                        <TextBlock x:Name="EtatDeLaCle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TexteDoux}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pied. Les versions des outils, l'accès au compte Spotify et au journal. -->
            <Border BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="Bahnschrift"
                                TextElement.FontSize="12" TextElement.Foreground="{StaticResource TexteEtiquette}">
                        <TextBlock x:Name="TexteVersion" Text="Recherche des outils…" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="VersionFfmpeg" Margin="24,0,0,0"/>
                        <TextBlock x:Name="VersionDeno" Margin="24,0,0,0"/>
                        <TextBlock x:Name="VersionSpotDl" Margin="24,0,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="BasculeCle" Grid.Column="1" Style="{StaticResource BoutonTexte}" Height="32"
                                  Foreground="{StaticResource TexteDoux}" Content="Compte _Spotify"
                                  Checked="BasculerLaCle" Unchecked="BasculerLaCle"/>
                    <ToggleButton x:Name="BasculeJournal" Grid.Column="2" Style="{StaticResource BoutonTexte}" Height="32" Margin="0,0,-12,0"
                                  Foreground="{StaticResource TexteDoux}" Content="Afficher le _journal"
                                  Checked="BasculerLeJournal" Unchecked="BasculerLeJournal"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
